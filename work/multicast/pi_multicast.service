[Unit]
Description=pi_multicast Startup Script
After=network.target

[Service]
Type=simple
User=jph
WorkingDirectory=/home/jph/runhere
ExecStart=/usr/bin/python3 /home/jph/runhere/pi_multicast.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

